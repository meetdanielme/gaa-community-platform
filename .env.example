# Copy to .env.local for local overrides. None of these are needed for `pnpm dev`.

# Postgres connection string. Leave unset locally to use the built-in PGlite server.
# On Vercel, adding a Neon database sets this for you.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Required in production: secret used to sign sessions. Generate with:
#   openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Demo mode (default on): seeds the Saints sample club, shows the "Explore the demo"
# buttons, protects the shared demo accounts and resets everything nightly.
# Set to false for a real club.
# DEMO_MODE=false

# Comma-separated emails that become club admins when they sign up.
# Use this to create your club's first admin; after that, admins manage access in /admin/members.
# ADMIN_EMAILS=secretary@yourclub.ie

# Email (password resets, event reminders, cancellation notices) via Resend.
# Without these, emails are printed to the server log instead.
# RESEND_API_KEY=
# EMAIL_FROM=noreply@yourclub.ie

# Protects the daily job (/api/cron/daily). Vercel sends it automatically when set.
# CRON_SECRET=

# Optional: pin the public URL (otherwise derived from the request and limited to
# localhost and this Vercel deployment's own domains).
# BETTER_AUTH_URL=https://your-club.example.ie

# Optional: extra custom domains allowed for auth, comma-separated.
# AUTH_ALLOWED_HOSTS=your-club.ie,www.your-club.ie
